{
  "name": "central",
  "version": "0.4.1",
  "scripts": {
    "ng": "ng",
    "start": "npm run icons && npm run build:main && ng build && electron .",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist-electron --external:electron --external:@lydell/node-pty",
    "dev": "npm run icons && npm run build:main && concurrently -k -n ui,app \"ng serve --port 4300\" \"wait-on tcp:4300 && electron . --dev\"",
    "dist": "npm run icons && npm run build:main && ng build && electron-builder --win nsis",
    "icons": "node scripts/file-icons.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "^21.2.29",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "material-icon-theme": "^5.40.0",
    "material-symbols": "^0.48.2",
    "monaco-editor": "^0.52.2",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "wait-on": "^9.5.1"
  },
  "main": "dist-electron/main.js",
  "productName": "Central",
  "description": "Central: visão geral, agentes e IDE dos seus projetos",
  "author": "Gustavo Reis",
  "build": {
    "appId": "dev.gustavoreis.central",
    "productName": "Central",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "dist/web/browser/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Central"
    }
  }
}
